
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519

Host mac macbook
    HostName MacBook-Pro-5.local
    User rbarbosa
    IdentityFile ~/.ssh/id_ed25519
    AddressFamily inet
    # Share one authenticated connection for 10 min. JumpCloud counts every
    # login and flagged 129 in 24 h on 2026-11-02; reused connections do not log in.
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 10m

Host rigo-gmk
    HostName 192.168.15.15
    User rigo
