{
  "cleanupPeriodDays": 1095,
  "syncClaudeAiSkills": false,
  "env": {
    "CLAUDE_CODE_DISABLE_ARTIFACT": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SCROLL_SPEED": "10"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/rigo/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep|Glob|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/rigo/.claude/hooks/menial_nudge.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/rigo/.claude/projects/-home-rigo/memory/regen-index.py 2>/dev/null || true",
            "statusMessage": "Regenerating memory index"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/rigo/.local/lib/memory-server/memsrv.py hint",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/rigo/.claude/projects/-home-rigo/memory/regen-index.py --hook 2>/dev/null; true"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/rigo/.local/lib/memory-server/memsrv.py log-hook",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/rigo/.local/lib/memory-server/memsrv.py commit-hook",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/rigo/.claude/hooks/menial_nudge.py reset",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 /home/rigo/.claude/hooks/task_switch.py",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -c 'import sys; sys.path.insert(0, \"/home/rigo/.local/lib/memory-server\"); import memsrv; sys.exit(memsrv.main())' prompt-hook",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "humanizer@humanizer": true
  },
  "extraKnownMarketplaces": {
    "blender-agent-skills": {
      "source": {
        "source": "github",
        "repo": "EL4CTEO/blender-skills"
      }
    },
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    }
  },
  "outputStyle": "rigo",
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "verbose": true,
  "switchModelsOnFlag": false
}
